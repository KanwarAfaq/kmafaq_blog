# Browser-safe Supabase credentials (Project Settings -> API)
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_OR_PUBLISHABLE_KEY

# Used only by scripts/generate-seo.mjs during local/Vercel builds.
SITE_URL=https://kmafaq.online

# Cloudinary server-only credentials used by /api/cloudinary-signature.js.
# IMPORTANT: Never prefix API_SECRET with VITE_.
CLOUDINARY_CLOUD_NAME=YOUR_CLOUD_NAME
CLOUDINARY_API_KEY=YOUR_API_KEY
CLOUDINARY_API_SECRET=YOUR_API_SECRET

# Optional server aliases for Supabase auth verification inside the API route.
# If omitted, the route falls back to the VITE_SUPABASE_* values above.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_OR_PUBLISHABLE_KEY

# Optional public social links shown in the footer.
VITE_SOCIAL_FACEBOOK=https://facebook.com/
VITE_SOCIAL_LINKEDIN=https://linkedin.com/
VITE_SOCIAL_YOUTUBE=https://youtube.com/
VITE_SOCIAL_INSTAGRAM=https://instagram.com/

# IMPORTANT: Never put SUPABASE_SERVICE_ROLE_KEY or CLOUDINARY_API_SECRET in VITE_* variables.

# -----------------------------------------------------------------------------
# Python publishing agent (server/GitHub Actions only)
# The agent can read these from this root .env or from .env.agent.
# -----------------------------------------------------------------------------
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY
AGENT_AUTHOR_ID=
AGENT_POST_STATUS=published

GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GEMINI_API_KEY=
GEMINI_TEXT_MODEL=gemini-3.8-flash
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
LLM_PRIMARY=groq

TAVILY_API_KEY=
BRAVE_SEARCH_API_KEY=
PEXELS_API_KEY=
PIXABAY_API_KEY=

TREND_GEOS=US,PK,IN,GB,CA
MAX_TRENDS=40
MIN_TREND_RELEVANCE=45
RESEARCH_MAX_RESULTS=5
REQUEST_TIMEOUT_SECONDS=20

CLOUDINARY_AGENT_FOLDER=km-afaq/blog
DAILY_POST_LIMIT_PER_LANGUAGE=5
PUBLISH_TIMEZONE=Asia/Karachi
DUPLICATE_WINDOW_DAYS=3
ALLOW_PUBLISH_WITHOUT_IMAGE=false

LINE_CHANNEL_ACCESS_TOKEN=
LINE_USER_ID=
LINE_DAILY_SUMMARY_REQUIRED=true

# -----------------------------------------------------------------------------
# Reader profiles / personalized digests
# -----------------------------------------------------------------------------
# LINE Login must be a Web app channel under the SAME LINE provider as the
# Messaging API channel used by LINE_CHANNEL_ACCESS_TOKEN.
LINE_LOGIN_CHANNEL_ID=
LINE_LOGIN_CHANNEL_SECRET=
# Production callback. Local Vite dev automatically uses http://localhost:5173/api/line-callback.
# Register BOTH callback URLs in the LINE Login channel.
LINE_LOGIN_CALLBACK_URL=https://kmafaq.online/api/line-callback
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
LINE_STATE_SECRET=

# Email digests via SMTP
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-account@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM=your-account@gmail.com
SMTP_USE_TLS=true
SMTP_USE_SSL=false

# -----------------------------------------------------------------------------
# No-login LINE QR subscription (Messaging API channel)
# -----------------------------------------------------------------------------
# Channel secret from LINE Developers -> Messaging API channel -> Basic settings.
LINE_MESSAGING_CHANNEL_SECRET=
# Channel access token from LINE Developers -> Messaging API.
# Reuses LINE_CHANNEL_ACCESS_TOKEN above.
# Public add-friend URL such as https://lin.ee/xxxxxx
VITE_LINE_OFFICIAL_ACCOUNT_URL=
# Official QR image URL copied from LINE Official Account Manager.
VITE_LINE_ADD_FRIEND_QR_URL=
# LOCAL ONLY: public tunnel base URL used in LINE preference links.
# Example after running cloudflared/ngrok: https://abc123.trycloudflare.com
LINE_PUBLIC_BASE_URL=

# -----------------------------------------------------------------------------
# 4-digit OTP + sales notifications (server-only; never VITE_ prefix)
# -----------------------------------------------------------------------------
# Generate a long random value, e.g.:
# python -c "import secrets; print(secrets.token_urlsafe(48))"
OTP_PEPPER=
# Optional: where digital-product/job submission notices are sent.
SALES_NOTIFY_EMAIL=
# The OTP API also uses the SMTP_HOST/PORT/USERNAME/PASSWORD/FROM values above.
