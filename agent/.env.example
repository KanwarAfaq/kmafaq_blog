SITE_URL=https://kmafaq.online

# Text generation fallback: Groq -> Gemini -> OpenRouter Free
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GEMINI_API_KEY=
GEMINI_TEXT_MODEL=gemini-3.8-flash
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
LLM_PRIMARY=groq

# Topic discovery / research
TREND_GEOS=US,PK,IN,GB,CA
TREND_KEYWORDS=AI,artificial intelligence,ChatGPT,Gemini,Groq,automation,agent,technology,tech,software,coding,developer,cybersecurity,freelance,earning,earn,online income,remote work,SEO,digital marketing,startup,business,economy,market,inflation,interest rate,politics,election,government,policy,president,prime minister,parliament,war,conflict,ceasefire,military,diplomacy,cricket,football,soccer,F1,tennis,world cup,sports,breaking news,science,space,climate,health
MAX_TRENDS=40
MIN_TREND_RELEVANCE=45
TAVILY_API_KEY=
BRAVE_SEARCH_API_KEY=
RESEARCH_MAX_RESULTS=5
REQUEST_TIMEOUT_SECONDS=20

# Image fallback: Gemini -> Pexels -> Pixabay -> Openverse
PEXELS_API_KEY=
PIXABAY_API_KEY=
IMAGE_DOWNLOAD_MAX_MB=15

# Publishing
DAILY_POST_LIMIT_PER_LANGUAGE=5
PUBLISH_TIMEZONE=Asia/Karachi
DUPLICATE_WINDOW_DAYS=3
ALLOW_PUBLISH_WITHOUT_IMAGE=false

# Supabase
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
AGENT_AUTHOR_ID=
AGENT_POST_STATUS=published

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_AGENT_FOLDER=km-afaq/blog

# LINE only — one notification after the full 5 Urdu + 5 English day is complete
LINE_CHANNEL_ACCESS_TOKEN=
LINE_USER_ID=
LINE_DAILY_SUMMARY_REQUIRED=true

# Reader digests (separate from owner daily summary)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-account@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM=your-account@gmail.com
SMTP_USE_TLS=true
SMTP_USE_SSL=false

# No-login LINE subscribers use the Messaging API webhook.
LINE_MESSAGING_CHANNEL_SECRET=
# Optional during local tunnel testing so LINE replies point to your public tunnel.
LINE_PUBLIC_BASE_URL=
